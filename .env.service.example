HOST=127.0.0.1
PORT=8787
TRUST_PROXY_HOPS=0

SETUP_REPOSITORY=Bahbus/GameNightLibrary
SETUP_ALLOWED_ORIGINS=https://bahbus.github.io
SETUP_ALLOWED_CALLBACKS=https://bahbus.github.io/GameNightLibrary/
SETUP_SERVICE_ISSUER=https://setup-service.example.org/
SETUP_GRANT_TTL_SECONDS=900
SETUP_OAUTH_STATE_TTL_SECONDS=600

SETUP_GITHUB_APP_ID=replace-with-github-app-id
SETUP_GITHUB_CLIENT_ID=replace-with-github-app-client-id
SETUP_GITHUB_CLIENT_SECRET=replace-with-secret
SETUP_GITHUB_INSTALLATION_ID=replace-with-installation-id
SETUP_GITHUB_REPOSITORY_ID=replace-with-numeric-repository-id
SETUP_GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nreplace-with-private-key\n-----END RSA PRIVATE KEY-----"

# Generate independently, for example with: openssl rand -base64 48
SETUP_SIGNING_SECRET=replace-with-at-least-43-random-characters
