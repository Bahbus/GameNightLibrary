{
  "name": "game-night-library",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "catalog:build": "node --import tsx scripts/generateCatalog.ts",
    "house-editor:build": "node --import tsx scripts/generateHouseEditorData.ts",
    "service:build": "esbuild service/server.ts --bundle --platform=node --format=cjs --target=node24 --outfile=build/setup-service.cjs",
    "service:dev": "node --import tsx service/server.ts",
    "service:start": "node build/setup-service.cjs",
    "service:deploy": "node --import tsx scripts/deploySetupService.ts",
    "vercel:build": "tsc --noEmit -p tsconfig.service.json",
    "dev": "npm run catalog:build && vite",
    "build": "npm run catalog:build && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lighthouse": "node scripts/runLighthouse.mjs",
    "wiki:build": "node --import tsx scripts/generateWiki.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run service:build",
    "inventory:validate": "node --import tsx scripts/validateInventory.ts",
    "inventory:import": "node --import tsx scripts/importCsv.ts",
    "inventory:prepare": "node --import tsx scripts/prepareMatchingManifest.ts",
    "inventory:prepare-house": "node --import tsx scripts/prepareHouseIntake.ts",
    "inventory:finalize:check": "node --import tsx scripts/finalizeInventory.ts --check",
    "inventory:finalize:preview": "node --import tsx scripts/finalizeInventory.ts --preview",
    "inventory:finalize": "node --import tsx scripts/finalizeInventory.ts --write",
    "inventory:match": "node --import tsx scripts/matchInventory.ts",
    "repository:audit": "bash scripts/auditRepository.sh",
    "repository:configure": "bash scripts/configureRepository.sh",
    "request:apply": "node --import tsx scripts/applyIssueRequest.ts"
  },
  "dependencies": {
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.7",
    "octokit": "^5.0.5",
    "preact": "^10.29.8",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@preact/preset-vite": "^2.10.2",
    "@testing-library/preact": "^3.2.4",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-xml-parser": "^5.10.1",
    "jsdom": "^30.0.1",
    "lighthouse": "^13.4.1",
    "prettier": "^3.6.2",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vitest": "^4.0.13",
    "yaml": "^2.9.0"
  }
}
