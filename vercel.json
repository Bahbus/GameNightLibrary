{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run vercel:build",
  "outputDirectory": "service-static",
  "rewrites": [
    { "source": "/healthz", "destination": "/api" },
    { "source": "/revision.json", "destination": "/api" },
    { "source": "/auth/(.*)", "destination": "/api" },
    { "source": "/api/setup/(.*)", "destination": "/api" }
  ]
}
